# Copy to .env on the server (/opt/seattlebynight/.env) and fill in real values.
# The real file is never committed.

POSTGRES_DB=seattlebynight
POSTGRES_USER=seattlebynight
# Generate on the server with: openssl rand -hex 32
# Hex avoids the quoting problems that '#' or '$' in a Compose .env value cause.
POSTGRES_PASSWORD=CHANGE_ME

# The Tailscale address of this host (tailscale ip -4). The frontend binds here
# only, so the app is not exposed on the LAN.
TAILSCALE_IP=100.64.0.1

# Register this account through the app first; on the next restart it is granted
# the Administrator role. Role management is administrator-gated, so this is the
# only way into a fresh deployment.
BOOTSTRAP_ADMINISTRATOR_EMAIL=you@example.com
