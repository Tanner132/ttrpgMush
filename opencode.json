{
  "$schema": "https://opencode.ai",
  "instructions": [
    "AGENTS.md",
    "PROJECT_CONTEXT.md"
  ],
  "agent_options": {
    "generate_tags": false,
    "generate_followups": false,
    "stream_responses": true
  },
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen-fallback": {
          "id": "qwen3.8-optimized",
          "reasoning": false, 
          "tool_call": true
        }
      }
    }
  },
  "agent": {
    "plan": { "model": "gpt-5.6-sol-ultra", "temperature": 0.2 },
    "build": { "model": "deepseek/deepseek-v4-pro", "temperature": 0.0 }
  }
}
