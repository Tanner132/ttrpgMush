<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SeattleByNight.Domain\SeattleByNight.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="13.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pre-alpha: a single mutable canonical development schema, split into one
      file per top-level collection (plus catalog.json for rulesetId/version)
      and merged back into one document at load. See
      EmbeddedRulesetCatalogProvider's RetainedVersions comment and
      roadmap/SR5_RULESET_MANIFEST.md's "Schema Lifecycle" section. Once the
      schema is locked, new content becomes additional immutable resources
      here (a sr5-core-1.1.0 folder, etc.) rather than edits to these files.
    -->
    <!--
      LogicalName is explicit because MSBuild would otherwise mangle the
      version folder name into an identifier-safe form (sr5_core_1._0._0).
    -->
    <EmbeddedResource Include="CharacterCreation/Catalog/Resources/sr5-core-1.0.0/*.json">
      <LogicalName>SeattleByNight.Application.CharacterCreation.Catalog.Resources.sr5-core-1.0.0.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!--
      Milestone 5 game content (§50): encounter and mission definitions,
      split one file per content type and merged at load. Same explicit
      LogicalName trick as the catalog resources above.
    -->
    <EmbeddedResource Include="GameEngine/Missions/Resources/game-content-1.0.0/*.json">
      <LogicalName>SeattleByNight.Application.GameEngine.Missions.Resources.game-content-1.0.0.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
